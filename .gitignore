.DS_Store
.claude/settings.local.json
.vscode/settings.json
/.vscode
.vscode/settings.json

# Agent skill symlinks
.claude/skills/
.codex/skills/
.agents/skills/
.opencode/skills/

# Learner output from trial runs — runbooks are tracked, the courses they build are not
/learning/

# Iteration corpus — raw course materials may be copyright-sensitive
/tmp/*
!/tmp/README.md
# …but the synthetic fixture generator is not: contract tests must be reproducible
!/tmp/skill-tests/
/tmp/skill-tests/*
!/tmp/skill-tests/make-fixtures.sh
!/tmp/skill-tests/RUNBOOK.md

# Session scratch — handoffs and transient working notes
/.scratch/

# Source registry — the README is the schema, the domain files are the author's
/sources/*
!/sources/README.md

# Synapse protocol output — regenerated by `uv run synapse manifest generate`.
# Ignored, not published: it indexes gitignored learner state under learning/ and sources/,
# and synapse reads sibling checkouts locally rather than from git.
/.learning-manifest.json
/.synapse-cache.json

# Private editorial snapshots; installed skills write in the active writing workspace.
/writing-memory/
